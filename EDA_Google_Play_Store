Content Rating\", \"Genres\",\n","        \"Last Updated\", \"Current Ver\", \"Android Ver\"\n","    ]\n","\n","    df[fix_cols] = df[fix_cols].astype(\"object\")\n","\n","    df.loc[idx, fix_cols] = [\n","        \"LIFESTYLE\",\n","        \"1.9\",\n","        \"19\",\n","        \"3.0M\",\n","        \"1,000+\",\n","        \"Free\",\n","        \"0\",\n","        \"Everyone\",\n","        \"Lifestyle\",\n","        \"February 11, 2018\",\n","        \"1.0.19\",\n","        \"4.0 and up\"\n","    ]\n","\n","    print(\"Corrected malformed row:\", idx)\n","\n","\n","# Clean text columns\n","\n","text_columns = [\n","    \"App\", \"Category\", \"Type\",\n","    \"Content Rating\", \"Genres\",\n","    \"Current Ver\", \"Android Ver\"\n","]\n","\n","for col in text_columns:\n","    df[col] = df[col].astype(\"string\").str.strip()\n","\n","df[\"Category\"] = (\n","    df[\"Category\"]\n","    .str.replace(\"_\", \" \", regex=False)\n","    .str.upper()\n",")\n","\n","df[\"Type\"] = df[\"Type\"].str.title()\n","\n","\n","# Check for blank text values\n","\n","for col in text_columns:\n","    blank_count = df[col].fillna(\"\").str.strip().eq(\"\").sum()\n","    print(f\"{col} blank values:\", blank_count)\n","\n","\n","# Convert numeric columns\n","\n","df[\"Rating\"] = pd.to_numeric(df[\"Rating\"], errors=\"coerce\")\n","df[\"Reviews\"] = pd.to_numeric(df[\"Reviews\"], errors=\"coerce\")\n","\n","df[\"Installs\"] = (\n","    df[\"Installs\"]\n","    .astype(\"string\")\n","    .str.replace(\",\", \"\", regex=False)\n","    .str.replace(\"+\", \"\", regex=False)\n",")\n","\n","df[\"Installs\"] = pd.to_numeric(df[\"Installs\"], errors=\"coerce\")\n","\n","df[\"Price\"] = (\n","    df[\"Price\"]\n","    .astype(\"string\")\n","    .str.replace(\"$\", \"\", regex=False)\n",")\n","\n","df[\"Price\"] = pd.to_numeric(df[\"Price\"], errors=\"coerce\")\n","\n","\n","# Check Type and Price consistency\n","\n","inconsistent_price = (\n","    ((df[\"Type\"] == \"Free\") & (df[\"Price\"] > 0)) |\n","    ((df[\"Type\"] == \"Paid\") & (df[\"Price\"] == 0))\n",")\n","\n","print(\n","    \"Potential Type/Price inconsistencies:\",\n","    inconsistent_price.sum()\n",")\n","\n","if inconsistent_price.any():\n","    display(\n","        df.loc[\n","            inconsistent_price,\n","            [\"App\", \"Type\", \"Price\"]\n","        ]\n","    )\n","\n","\n","# Handle missing Type\n","\n","df.loc[\n","    df[\"Type\"].isna() & (df[\"Price\"] == 0),\n","    \"Type\"\n","] = \"Free\"\n","\n","\n","# Convert Size to MB\n","\n","def parse_size(value):\n","    if pd.isna(value):\n","        return np.nan\n","\n","    value = str(value).strip()\n","\n","    if value.lower() == \"varies with device\":\n","        return np.nan\n","\n","    if value.endswith(\"M\"):\n","        try:\n","            return float(value[:-1])\n","        except ValueError:\n","            return np.nan\n","\n","    if value.endswith(\"k\"):\n","        try:\n","            return float(value[:-1]) / 1024\n","        except ValueError:\n","            return np.nan\n","\n","    try:\n","        return float(value)\n","    except ValueError:\n","        return np.nan\n","\n","\n","df[\"Size_MB\"] = df[\"Size\"].apply(parse_size)\n","\n","\n","# Convert date\n","\n","df[\"Last Updated\"] = pd.to_datetime(\n","    df[\"Last Updated\"],\n","    errors=\"coerce\"\n",")\n","\n","\n","# Remove exact duplicate rows\n","\n","duplicates = df.duplicated().sum()\n","\n","df = df.drop_duplicates().copy()\n","\n","print(\"Exact duplicates removed:\", duplicates)\n","print(\"Shape after removing duplicates:\", df.shape)\n","\n","\n","# Check repeated app names\n","\n","unique_apps = df[\"App\"].nunique()\n","repeated_apps = df[\"App\"].duplicated(keep=False).sum()\n","\n","print(\"Unique apps:\", unique_apps)\n","print(\"Rows with repeated app names:\", repeated_apps)\n","\n","\n","# Check invalid numeric values\n","\n","invalid_rating = (\n","    df[\"Rating\"].notna() &\n","    ~df[\"Rating\"].between(0, 5)\n",")\n","\n","invalid_reviews = (\n","    df[\"Reviews\"].notna() &\n","    (df[\"Reviews\"] < 0)\n",")\n","\n","invalid_installs = (\n","    df[\"Installs\"].notna() &\n","    (df[\"Installs\"] < 0)\n",")\n","\n","invalid_price = (\n","    df[\"Price\"].notna() &\n","    (df[\"Price\"] < 0)\n",")\n","\n","print(\"\\nInvalid ratings:\", invalid_rating.sum())\n","print(\"Invalid reviews:\", invalid_reviews.sum())\n","print(\"Invalid installs:\", invalid_installs.sum())\n","print(\"Invalid prices:\", invalid_price.sum())\n","\n","\n","# Check reviews vs installs\n","\n","reviews_vs_installs = (\n","    df[\"Reviews\"] > df[\"Installs\"]\n",")\n","\n","print(\n","    \"Reviews greater than installs:\",\n","    reviews_vs_installs.sum()\n",")\n","\n","if reviews_vs_installs.any():\n","    display(\n","        df.loc[\n","            reviews_vs_installs,\n","            [\"App\", \"Reviews\", \"Installs\"]\n","        ]\n","    )\n","\n","\n","# Remove rows with missing installs\n","\n","before = len(df)\n","\n","df = df[df[\"Installs\"].notna()].copy()\n","\n","print(\n","    \"Rows removed due to missing installs:\",\n","    before - len(df)\n",")\n","\n","\n","# Missing values\n","\n","missing_summary = pd.DataFrame({\n","    \"Missing Values\": df.isna().sum(),\n","    \"Missing %\": (df.isna().mean() * 100).round(2)\n","})\n","\n","missing_summary = (\n","    missing_summary[\n","        missing_summary[\"Missing Values\"] > 0\n","    ]\n","    .sort_values(\"Missing Values\", ascending=False)\n",")\n","\n","display(missing_summary)\n","\n","\n","# Keep missing ratings as they are\n","\n","print(\n","    f\"\\nMissing ratings: {df['Rating'].isna().sum()} \"\n","    f\"({df['Rating'].isna().mean():.2%})\"\n",")\n","\n","print(\"Missing ratings are kept as NaN.\")\n","\n","\n","# Check categories and other categorical columns\n","\n","print(\"\\nCategories:\")\n","print(sorted(df[\"Category\"].dropna().unique()))\n","\n","print(\"\\nType counts:\")\n","print(df[\"Type\"].value_counts(dropna=False))\n","\n","print(\"\\nContent Rating counts:\")\n","print(df[\"Content Rating\"].value_counts(dropna=False))\n","\n","\n","# Check dates\n","\n","print(\"\\nInvalid dates:\", df[\"Last Updated\"].isna().sum())\n","print(\"Earliest date:\", df[\"Last Updated\"].min())\n","print(\"Latest date:\", df[\"Last Updated\"].max())\n","\n","\n","# Create one row per app for app-level analysis\n","\n","app_level = (\n","    df.sort_values(\n","        [\"App\", \"Last Updated\", \"Reviews\"],\n","        na_position=\"first\"\n","    )\n","    .drop_duplicates(\"App\", keep=\"last\")\n","    .reset_index(drop=True)\n",")\n","\n","print(\"\\nCleaned dataset:\", df.shape)\n","print(\"App-level dataset:\", app_level.shape)\n","\n","assert app_level[\"App\"].duplicated().sum() == 0\n","\n","print(\"App-level dataset contains one row per app.\")\n","\n","\n","# Final checks\n","\n","print(\"\\nFinal checks\")\n","print(\"Duplicate rows:\", df.duplicated().sum())\n","print(\"Missing installs:\", df[\"Installs\"].isna().sum())\n","print(\"Missing Type:\", df[\"Type\"].isna().sum())\n","\n","print(\n","    \"Invalid ratings:\",\n","    (\n","        df[\"Rating\"].notna() &\n","        ~df[\"Rating\"].between(0, 5)\n","    ).sum()\n",")\n","\n","print(\n","    \"Invalid reviews:\",\n","    (\n","        df[\"Reviews\"].notna() &\n","        (df[\"Reviews\"] < 0)\n","    ).sum()\n",")\n","\n","print(\n","    \"Invalid installs:\",\n","    (\n","        df[\"Installs\"].notna() &\n","        (df[\"Installs\"] < 0)\n","    ).sum()\n",")\n","\n","print(\n","    \"Invalid prices:\",\n","    (\n","        df[\"Price\"].notna() &\n","        (df[\"Price\"] < 0)\n","    ).sum()\n",")\n","\n","print(\n","    \"Reviews greater than installs:\",\n","    (df[\"Reviews\"] > df[\"Installs\"]).sum()\n",")\n","\n","\n","# Final data types and preview\n","\n","display(df.dtypes.to_frame(\"Data Type\"))\n","display(df.head())"]},{"cell_type":"code","e