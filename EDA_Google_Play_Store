\"].apply(size_to_mb)\n\n# cleaner category name, e.g. ART_AND_DESIGN -> Art & Design\ndf[\"CategoryClean\"] = df[\"Category\"].str.replace(\"_\", \" \").str.title().str.replace(\" And \", \" & \")\n\n# first genre only, e.g. \"Art & Design;Pretend Play\" -> \"Art & Design\"\ndf[\"PrimaryGenres\"] = df[\"Genres\"].str.split(\";\").str[0]\n\n# date parts\ndf[\"Year\"] = df[\"Last Updated\"].dt.year\ndf[\"MonthNum\"] = df[\"Last Updated\"].dt.month\ndf[\"Month\"] = df[\"Last Updated\"].dt.month_name()\n\n# groups used in charts (same ranges as the Power BI report)\ndf[\"Bucket_Size\"] = pd.cut(df[\"Size_MB\"], bins=[0, 10, 25, 50, 100, np.inf],\n                           labels=[\"0-10MB\", \"10-25MB\", \"25-50MB\", \"50-100MB\", \"100MB+\"])\ndf[\"Bucket_Size\"] = df[\"Bucket_Size\"].astype(\"string\").fillna(\"Varies with device\")\n\ndf[\"Rating_Bucket\"] = pd.cut(df[\"Rating\"], bins=[0, 1, 2, 3, 4, 5],\n                             labels=[\"0-1\", \"1-2\", \"2-3\", \"3-4\", \"4-5\"], include_lowest=True)\n\npaid_price = df[\"Price\"].where(df[\"Type\"] == \"Paid\")\ndf[\"Price_Bucket\"] = pd.cut(paid_price, bins=[0, 1, 5, 10, 20, 50, np.inf],\n                            labels=[\"$0-1\", \"$1-5\", \"$5-10\", \"$10-20\", \"$20-50\", \"$50+\"])\n\ndf[\"Installs_Bucket\"] = pd.cut(df[\"Installs\"], bins=[-1, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, np.inf],\n                               labels=[\"0-1K\", \"1K-10K\", \"10K-100K\", \"100K-1M\", \"1M-10M\", \"10M-100M\", \"100M+\"])\n\ndf[\"Has_Rating\"] = df[\"Rating\"].notna().astype(int)\n\n# missing values - Rating and Size are kept empty on purpose\n# (apps with no rating are mostly very new/small apps, filling them would change the average)\nmissing = df[list(apps_raw.columns) + [\"Size_MB\"]].isna().sum()\nmissing = missing[missing > 0]\nprint(\"\\nMissing values:\")\nprint(pd.DataFrame({\"count\": missing, \"percent\": (missing / len(df) * 100).round(2)}))\n\n# quick checks\nprint(\"\\nRating outside 0-5:\", (~df[\"Rating\"].dropna().between(0, 5)).sum())\nprint(\"Negative reviews/installs/price:\",\n      (df[\"Reviews\"] < 0).sum(), (df[\"Installs\"] < 0).sum(), (df[\"Price\"] < 0).sum())\nprint(\"Reviews more than installs:\", (df[\"Reviews\"] > df[\"Installs\"]).sum(),\n      \"(kept - installs is a minimum value like 1+)\")\n\n# same app can appear more than once (scraped on different times / in 2 categories)\n# keep the latest row with most reviews for each app\napp_level = (df.sort_values([\"App\", \"Last Updated\", \"Reviews\"])\n               .drop_duplicates(\"App\", keep=\"last\")\n               .reset_index(drop=True))\n\nprint(\"\\nCleaned rows:\", len(df))\nprint(\"Unique apps (app_level):\", len(app_level))\n\ndf.head()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-12T19:37:20.085369Z","iopub.execute_input":"2026-11-12T19:37:20.085657Z","iopub.status.idle":"2026-11-12T19:37:20.418303Z","shell.execute_reply.started":"2026-11-12T19:37:20.085632Z","shell.execute_reply":"2026-11-12T19:37:20.417659Z"}},"outputs":[{"name":"stdout","text":"Rows before cleaning: 10841\nShifted row: 1\nExact duplicates: 483\n\nMissing values:\n             count  percent\nRating        1465    14.15\nCurrent Ver      8     0.08\nAndroid Ver      2     0.02\nSize_MB       1526    14.73\n\nRating outside 0-5: 0\nNegative reviews/installs/price: 0 0 0\nReviews more than installs: 11 (kept - installs is a minimum value like 1+)\n\nCleaned rows: 10357\nUnique apps (app_level): 9659\n","output_type":"stream"},{"execution_count":52,"output_type":"execute_result","data":{"text/plain":"                                                 App        Category  Rating  \\\n0     Photo Editor & Candy Camera & Grid & ScrapBook  ART_AND_DESIGN     4.1   \n1                                Coloring book moana  ART_AND_DESIGN     3.9   \n2  U Launcher Lite – FREE Live Cool Themes, Hide ...  ART_AND_DESIGN     4.7   \n3                              Sketch - Draw & Paint  ART_AND_DESIGN